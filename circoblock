  exit 1
  ;;
  *)
  if [ -f "$1" ]
  then
   break
  else
  echo "Unknown option: "$1
  print_usage_chromosome
  exit 1
  fi
  ;;
  esac
 done

 # Dependencies

  if ! command -v Rscript &> /dev/null
  then
   echo "R not installed" >&2
   echo "sudo apt install r-base" >&2
   deps+="rscript"
  fi
  
  if [ ! -z ${deps+x} ]
  then
   exit 1
  fi
  
  if [ -z ${genome+x} ] && [ -z ${tblastn+x} ]
