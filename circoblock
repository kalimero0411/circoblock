  fi
  
  echo "circoblock start: "$(date +"%d/%m/%Y %H:%M:%S") >&2
      
  # Map blocks to genome
  if [ -z ${tblastn+x} ]
  then
   tblastn_map
  fi
 
 Rscript $script_dir"/blocks_prob.R" \
 --wd $outdir \
 --blocks "$tblastn" \
 --chr_lengths "$lengths" \
 --chr_cutoff ${chr_cutoff} \
 --cont_block_cutoff ${cont_block_cutoff}
 
 else
 
  print_usage
  exit 1
 
fi

echo "circoblock done: "$(date +"%d/%m/%Y %H:%M:%S") >&2
