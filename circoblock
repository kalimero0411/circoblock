  Length files are tab-delimited: chromosome [TAB] length
	
  Example: circoblock circos --threads 32 --genome TAIR10_genome.fa --species1 'Arabidopsis thaliana' --species2 'Some species' --gff1 TAIR10.gff3 --gff1 TAIR10_TEs.gtf --gff1 species2_genes.bed --gff2 species2_TEs.gff --lengths1 TAIR10.lengths --lengths2 species2.lengths -c chain_dir/At.sp2.final.chain --outdir path
"
printf "$usage" | awk -F $'\t' '{ printf "%-30s %s\n", $1, $2 }'
}

